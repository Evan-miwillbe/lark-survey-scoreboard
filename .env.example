# Feishu app credentials. If lark-cli is already logged in on this machine,
# the local server can also read ~/.lark-cli/config.json and appsecret.txt.
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret

# Feishu Base / Form used as the official questionnaire entry.
FEISHU_BASE_TOKEN=your_base_token
FEISHU_TABLE_ID=your_table_id
FEISHU_FORM_ID=your_form_view_id
FEISHU_BASE_URL=https://your-tenant.feishu.cn/base/your_base_token
FEISHU_FORM_URL=https://your-tenant.feishu.cn/base/your_base_token?table=your_table_id&view=your_form_view_id

# Local dev server port. FC3 may provide FC_SERVER_PORT in deployment.
PORT=3000
CACHE_TTL_MS=3000
LIVE_POLL_MS=3000
