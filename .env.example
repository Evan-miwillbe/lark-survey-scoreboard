# 飞书应用凭据（从 lark-cli login 或飞书开放平台获取）
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret

# 飞书 Base 配置（从 lark-cli base +base-create 获取）
FEISHU_BASE_TOKEN=your_base_token
FEISHU_TABLE_ID=your_table_id

# 字段名（必须与飞书表单中的题目标题一致）
NAME_FIELD=您的姓名
DEPT_FIELD=部门名称

# 服务端口（本地开发用，FC3 会自动设置 FC_SERVER_PORT）
PORT=3000
